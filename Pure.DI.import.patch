+namespace Pure.DI.IntegrationTests;
+
+/// <summary>
+/// Tests related to imports, dependencies supplied by whoever creates the composition.
+/// </summary>
+public class ImportTests
+{
+    [Fact]
+    public async Task ShouldResolveImportOnEveryInjection()
+    {
+        // Given
+
+        // When
+        var result = await """
+                           using System;
+                           using Pure.DI;
+
+                           namespace Sample
+                           {
+                              interface IClock
+                              {
+                                  int Now { get; }
+                              }
+
+                              class Clock: IClock
+                              {
+                                  public Clock(int now) => Now = now;
+
+                                  public int Now { get; }
+                              }
+
+                              class Service
+                              {
+                                  public Service(IClock clock1, IClock clock2) => Name = $"{clock1.Now} {clock2.Now}";
+
+                                  public string Name { get; }
+                              }
+
+                              static class Setup
+                              {
+                                  private static void SetupComposition()
+                                  {
+                                      DI.Setup("Composition")
+                                          .Import<IClock>()
+                                          .Root<Service>("Service");
+                                  }
+                              }
+
+                              public class Program
+                              {
+                                  public static void Main()
+                                  {
+                                      var now = 0;
+                                      var composition = new Composition(clock: () => new Clock(++now));
+                                      Console.WriteLine(composition.Service.Name);
+                                      Console.WriteLine(composition.Service.Name);
+                                  }
+                              }
+                           }
+                           """.RunAsync();
+
+        // Then
+        result.Success.ShouldBeTrue(result);
+        result.StdOut.ShouldBe(["1 2", "3 4"], result);
+    }
+
+    [Fact]
+    public async Task ShouldSupportTaggedImports()
+    {
+        // Given
+
+        // When
+        var result = await """
+                           using System;
+                           using Pure.DI;
+
+                           namespace Sample
+                           {
+                              class Service
+                              {
+                                  public Service([Tag("first")] string first, [Tag("second")] string second, string name) =>
+                                      Name = $"{first} {second} {name}";
+
+                                  public string Name { get; }
+                              }
+
+                              static class Setup
+                              {
+                                  private static void SetupComposition()
+                                  {
+                                      DI.Setup("Composition")
+                                          .Import<string>("first")
+                                          .Import<string>("second")
+                                          .Import<string>()
+                                          .Root<Service>("Service");
+                                  }
+                              }
+
+                              public class Program
+                              {
+                                  public static void Main()
+                                  {
+                                      var composition = new Composition(stringFirst: () => "a", stringSecond: () => "b", stringImport: () => "c");
+                                      Console.WriteLine(composition.Service.Name);
+                                  }
+                              }
+                           }
+                           """.RunAsync();
+
+        // Then
+        result.Success.ShouldBeTrue(result);
+        result.StdOut.ShouldBe(["a b c"], result);
+        result.GeneratedCode.ShouldContain("[global::Pure.DI.TagAttribute(\"first\")] System.Func<string> stringFirst");
+        result.GeneratedCode.ShouldContain("[global::Pure.DI.TagAttribute(\"second\")] System.Func<string> stringSecond");
+    }
+}
