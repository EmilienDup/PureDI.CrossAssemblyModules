+    private void VisitImport(
+        InvocationExpressionSyntax invocation,
+        IMetadataVisitor metadataVisitor,
+        SemanticModel semanticModel,
+        GenericNameSyntax genericName,
+        IReadOnlyCollection<string> importComments)
+    {
+        if (genericName.TypeArgumentList.Arguments is not [{} importTypeSyntax]
+            || semanticModel.Compilation.GetTypeByMetadataName("System.Func`1") is not {} funcType)
+        {
+            NotSupported(invocation);
+            return;
+        }
+
+        var importType = semantic.GetTypeSymbol<ITypeSymbol>(semanticModel, importTypeSyntax);
+        var importFuncType = funcType.Construct(importType);
+        var tags = BuildTags(semanticModel, invocation.ArgumentList.Arguments);
+        var importTag = new MdTag(0, idGenerator.Generate() + "Import" + Names.Salt);
+
+        // The supplier passes a factory as a composition argument
+        metadataVisitor.VisitContract(new MdContract(semanticModel, invocation, importFuncType, ContractKind.Explicit, ImmutableArray.Create(importTag)));
+        metadataVisitor.VisitArg(new MdArg(semanticModel, invocation, importFuncType, GetImportName(importType, tags), ArgKind.Composition, false, importComments, ImportTags: tags));
+
+        // which is called on every injection, so the supplier owns the lifetime
+        var factory = new Lines();
+        factory.AppendLine($"({Names.IContextTypeName} {Names.ContextInstance}) =>");
+        using (factory.CreateBlock())
+        {
+            factory.AppendLine($"{Names.ContextInstance}.{nameof(IContext.Inject)}({importTag.Value.ValueToString()}, out {symbolNames.GetGlobalName(importFuncType)} import);");
+            factory.AppendLine("return import();");
+        }
+
+        var lambda = (ParenthesizedLambdaExpressionSyntax)SyntaxFactory.ParseExpression(factory.ToString());
+        var contextParameter = lambda.ParameterList.Parameters[0];
+        var factoryApiWalker = factoryApiWalkerFactory();
+        factoryApiWalker.Initialize(semanticModel, contextParameter, lambda);
+        factoryApiWalker.Visit(lambda);
+
+        // The lambda is not part of the compilation, so the injected type and tag cannot be inferred from it
+        var resolvers = factoryApiWalker.Meta
+            .Where(meta => meta.Kind == FactoryMetaKind.Resolver)
+            .Select(meta => new MdResolver(
+                semanticModel,
+                meta.Expression,
+                meta.Position,
+                importFuncType,
+                importTag,
+                meta.Expression.ArgumentList.Arguments[1].Expression,
+                ImmutableArray<MdOverride>.Empty))
+            .ToImmutableArray();
+
+        metadataVisitor.VisitContract(new MdContract(semanticModel, invocation, importType, ContractKind.Explicit, tags));
+        metadataVisitor.VisitFactory(
+            new MdFactory(
+                semanticModel,
+                invocation,
+                importType,
+                localVariableRenamingRewriterFactory(),
+                lambda,
+                false,
+                contextParameter,
+                resolvers,
+                ImmutableArray<MdInitializer>.Empty,
+                false));
+    }
+
+    // ILogger, "audit" -> loggerAudit; string -> stringImport
+    private static string GetImportName(ITypeSymbol importType, ImmutableArray<MdTag> tags)
+    {
+        var typeName = importType.Name;
+        if (importType.TypeKind == TypeKind.Interface && typeName.Length > 1 && typeName[0] == 'I' && char.IsUpper(typeName[1]))
+        {
+            typeName = typeName.Substring(1);
+        }
+
+        var tagName = tags.IsDefaultOrEmpty || tags[0].Value is null ? "" : NameFormatter.ToValidIdentifier(tags[0].Value!.ToString().Replace("\"", ""));
+        if (tagName.Length > 0)
+        {
+            tagName = char.ToUpperInvariant(tagName[0]) + tagName.Substring(1);
+        }
+
+        var name = NameFormatter.ToValidIdentifier(char.ToLowerInvariant(typeName[0]) + typeName.Substring(1) + tagName);
+        return SyntaxFacts.GetKeywordKind(name) == SyntaxKind.None ? name : name + "Import";
+    }
